# ===== SKanban — Configuração =====

# URL base da API do CVCRM (sem trailing slash)
CVCRM_BASE_URL=https://seu-cvcrm.com.br/api

# Token de autenticação do CVCRM
CVCRM_TOKEN=seu-token-aqui

# Ativar dados mock para desenvolvimento (true/false)
USE_MOCK=true

# Porta do servidor
PORT=3000

# Chave secreta para sessões
SESSION_SECRET=skanban-secret-key-change-me
